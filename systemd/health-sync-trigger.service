# The dashboard's Sync button: health-proxy forwards POST /api/sync here, and
# this can only start oura-sync.service, once per 15 minutes. See
# ../sync-trigger.py. Logged as a `journal` source.
[Unit]
Description=health.bix.computer sync button
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matt
Group=matt
ExecStart=/usr/bin/python3 -I /home/matt/apps/health/sync-trigger.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
