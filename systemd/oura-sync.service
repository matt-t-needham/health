# Drains the Oura ring's history over Bluetooth into ~/health/data/oura.db,
# which the `health` compose service (health.bix.computer) reads. Runs on the
# host because the container has no Bluetooth; the binary is copied out of the
# image's build stage (see ../CLAUDE.md). Started by oura-sync.timer and by the
# dashboard's Sync button (health-sync-trigger). Logged as a `journal` source.
#
# sync.sh retries connect + sync for up to 15 min, stamps
# bix-infra/logs/oura-sync/last-success on success (the nightly compiler's
# heartbeat check), and fails the unit when nothing synced.
[Unit]
Description=Sync the Oura ring over Bluetooth
Wants=bluetooth.target
After=bluetooth.target

[Service]
Type=oneshot
User=matt
Group=matt
ExecStart=/home/matt/apps/health/sync.sh
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/matt/health/data /home/matt/apps/bix-infra/logs/oura-sync
