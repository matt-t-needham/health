[Unit]
Description=Sync the Oura ring every hour

[Timer]
# Hourly: each run waits up to 15 min for the ring and only connects once it
# has seen it advertise, so runs while it's out of range cost the ring nothing.
OnCalendar=hourly
# Catch up after the HTPC was off at a scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
