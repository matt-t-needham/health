+    // A night of still sleep on the accelerometer, with `moves` (epochs) of movement on
+    // it and the ring's "activity" call at `ring_active` (epochs).
+    fn night_with_acm(moves: &[i64], ring_active: &[i64]) -> Vec<i64> {
+        let start_ds = 100_000i64;
+        let end_ds = start_ds + 800 * 300;
+        let (mut hr_t, mut hrv_t) = (Vec::new(), Vec::new());
+        for i in 0..80 {
+            hr_t.push((start_ds + i * 3_000, 55.0));
+            hrv_t.push((start_ds + i * 3_000, 40.0));
+        }
+        // acm events are stamped at the end of their 30 s window
+        let acm_t: Vec<(i64, f64)> = (0..800)
+            .map(|e| (start_ds + e * 300 + 300, if moves.contains(&e) { 30.0 } else { 0.04 }))
+            .collect();
+        let ring_active_t: Vec<i64> = ring_active.iter().map(|e| start_ds + e * 300).collect();
+        stage_night_from_signals_with_activity(
+            start_ds, end_ds, &hr_t, &hrv_t, &[], &acm_t, &ring_active_t,
+        )
+    }
