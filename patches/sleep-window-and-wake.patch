+/// Where a night extended past the ring's declared end (`raw_end_ds`) and its
+/// hypnogram scores every epoch of that extension awake, the number of epochs to keep
+/// so the night ends at the ring's call. `None` when there is nothing to trim.
+fn wake_extension_cut(stages: &[i64], start_ds: i64, end_ds: i64, raw_end_ds: i64) -> Option<usize> {
+    if stages.is_empty() || end_ds <= raw_end_ds || raw_end_ds <= start_ds {
+        return None;
+    }
+    let epoch_ds = (end_ds - start_ds) as f64 / stages.len() as f64;
+    let cut = (((raw_end_ds - start_ds) as f64 / epoch_ds).round() as usize).min(stages.len());
+    (cut > 0 && cut < stages.len() && stages[cut..].iter().all(|&c| c == 4)).then_some(cut)
+}
