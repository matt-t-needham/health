+    #[test]
+    fn ring_activity_marks_the_still_spells_between_linked_movements_awake() {
+        // Shape of 2026-10-17 02:58–03:38: movements at most ~6 min (12 epochs) apart
+        // around the ring's activity call, still in between. A roll-over 15 min before
+        // the first of them is not part of the bout.
+        let moves = [370, 400, 412, 424, 436, 448, 460, 472];
+        let stages = night_with_acm(&moves, &[425]);
+        assert!(stages[402..470].iter().all(|&c| c == 4), "{:?}", &stages[396..480]);
+        assert!(!stages[360..390].contains(&4), "{:?}", &stages[360..390]);
+        let (m, _) = sleep_metrics(&stages, 800.0 * 30.0);
+        assert_eq!(m["awakenings"], 1);
+    }
+
+    #[test]
+    fn the_same_movements_without_a_ring_activity_call_stay_asleep() {
+        let stages = night_with_acm(&[400, 412, 424, 436, 448, 460, 476], &[]);
+        assert!(!stages[100..700].contains(&4), "{:?}", &stages[396..480]);
+    }
+
