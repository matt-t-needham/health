+    // A night whose motion is quiet apart from one mid-night stretch, at `moving` epochs.
+    fn night_with_midnight_motion(moving: &[usize], seconds: f64) -> Vec<i64> {
+        let start_ds = 100_000i64;
+        let end_ds = start_ds + 800 * 300;
+        let (mut hr_t, mut hrv_t, mut motion_t) = (Vec::new(), Vec::new(), Vec::new());
+        for i in 0..80 {
+            hr_t.push((start_ds + i * 3_000, 55.0));
+            hrv_t.push((start_ds + i * 3_000, 40.0));
+        }
+        for e in (0..20).chain(786..800).chain(moving.iter().map(|&e| e as i64)) {
+            motion_t.push((start_ds + e * 300, if e < 20 || e >= 786 { 9.0 } else { seconds }));
+        }
+        motion_t.sort_by_key(|&(ds, _)| ds);
+        stage_night_from_signals(start_ds, end_ds, &hr_t, &hrv_t, &motion_t)
+    }
+
+    #[test]
+    fn sustained_midnight_movement_is_one_awakening() {
+        // moving in 7 of 10 epochs (400..409): got up
+        let stages = night_with_midnight_motion(&[400, 401, 402, 404, 405, 407, 409], 6.0);
+        assert!(stages[400..410].iter().all(|&c| c == 4), "{:?}", &stages[396..414]);
+        let (m, _) = sleep_metrics(&stages, 800.0 * 30.0);
+        assert_eq!(m["awakenings"], 1);
+    }
+
+    #[test]
+    fn brief_or_sparse_midnight_movement_is_not_wake() {
+        // hard roll-overs (20 s of a 30 s window) and 5 of 10 moving epochs stay asleep
+        for moving in [&[300usize, 301, 500][..], &[400, 402, 404, 406, 408]] {
+            let stages = night_with_midnight_motion(moving, 20.0);
+            assert!(!stages[290..520].contains(&4), "{moving:?}: {:?}", &stages[290..520]);
+            let (m, _) = sleep_metrics(&stages, 800.0 * 30.0);
+            assert_eq!(m["awakenings"], 0, "{moving:?}");
+        }
+    }
