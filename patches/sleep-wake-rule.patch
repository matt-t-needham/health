+    // Mid-night awakenings: sustained movement, not a single burst. The ring only logs
+    // a motion window when you moved in it, so a roll-over lights one or two epochs
+    // however hard it was, while getting up and walking lights nearly all of them.
+    // Any 5-minute stretch (WAKE_WINDOW epochs) with movement in at least
+    // WAKE_MIN_MOVING epochs is wake, from its first moving epoch to its last; the
+    // bout is then long enough to survive the 5-epoch mode smoothing below.
+    const WAKE_WINDOW: usize = 10;
+    const WAKE_MIN_MOVING: usize = 6;
+    if wake_end >= onset + WAKE_WINDOW {
+        for lo in onset..=(wake_end - WAKE_WINDOW) {
+            let win = lo..lo + WAKE_WINDOW;
+            let moving: Vec<usize> = win.filter(|&k| epoch_mo[k] > 0.0).collect();
+            if moving.len() >= WAKE_MIN_MOVING {
+                for cell in &mut stages[moving[0]..=moving[moving.len() - 1]] {
+                    *cell = 4;
+                }
             }
         }
     }
