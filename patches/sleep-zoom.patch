+.tl-z { --gut: 0px; --rgut: 0px; --z: 1; padding: 6px 0 4px; }
+.tl-tools {
+  display: flex; align-items: center; justify-content: flex-end; gap: 4px;
+  padding: 0 12px 6px; border-bottom: 1px solid var(--line-soft);
+}
+.tl-tools-k { font-size: 11px; color: var(--muted); letter-spacing: 0.04em; margin-right: 4px; }
+.tl-tools button {
+  font-family: var(--mono); font-size: 12px; color: var(--muted); cursor: pointer;
+  min-width: 38px; min-height: 32px; padding: 4px 8px;
+  background: transparent; border: 1px solid var(--line); border-radius: var(--radius-sm);
+}
+.tl-tools button[aria-pressed="true"] { color: var(--bg); background: var(--accent); border-color: var(--accent); }
+.tl-scroll { overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain; scrollbar-width: thin; }
+.tl-inner { width: calc(100% * var(--z)); padding: 0 14px; box-sizing: border-box; }
+.tl-z .tl-plots { touch-action: pan-y; }
+.tl-zoomed .tl-plots { touch-action: pan-x pan-y; }
+.tl-z .tl-row { display: grid; grid-template-columns: minmax(0, 1fr); height: 96px; }
+.tl-z .tl-gut {
+  grid-area: 1 / 1; justify-self: start; align-self: start; z-index: 3;
+  position: sticky; left: 0; pointer-events: none;
+  display: flex; align-items: baseline; gap: 8px; padding: 5px 8px 3px 10px; margin-left: -10px;
+  background: linear-gradient(to right, var(--surface) 85%, transparent);
+}
+.tl-z .tl-label { font-size: 12px; color: var(--text); opacity: 0.85; letter-spacing: 0.02em; }
+.tl-z .tl-val { font-size: 13px; margin: 0; min-height: 0; }
+.tl-scale { font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 11px; color: var(--muted); }
+.tl-z .tl-plot { grid-area: 1 / 1; margin-top: 26px; height: calc(100% - 26px); }
+.tl-bands {
+  grid-area: 1 / 1; justify-self: start; position: sticky; left: 0; z-index: 3; pointer-events: none;
+  margin: 28px 0 4px -10px; display: grid; grid-template-rows: repeat(4, 1fr); align-items: center;
+}
+.tl-bands span {
+  justify-self: start; font-size: 10px; letter-spacing: 0.03em; color: var(--text);
+  padding: 1px 5px 1px 10px; border-radius: 0 4px 4px 0;
+  background: color-mix(in oklab, var(--surface) 72%, transparent);
+}
+.tl-z .lane-svg { inset: 2px 0 4px; height: calc(100% - 6px); }
+.tl-z .tl-vline { background: var(--line-soft); }
+.tl-z .tl-vline.major { background: var(--line); }
+.tl-z .tl-axis span { font-size: 11px; color: var(--muted); }
+.tl-z .tl-pill { top: 2px; }
+.tl-out {
+  position: absolute; top: 0; bottom: 0; z-index: 2; pointer-events: none;
+  left: calc(100% * var(--f)); width: calc(100% * var(--w));
+  background: color-mix(in oklab, var(--surface) 55%, transparent);
+}
+.tl-edge {
+  position: absolute; top: 0; bottom: 0; width: 0; z-index: 2; pointer-events: none;
+  left: calc(100% * var(--f)); border-left: 1px dashed color-mix(in oklab, var(--muted) 70%, transparent);
+}
+/* bolder lines than the day-wide boxes: these are read on a phone */
+.tl-z .ln-line { stroke-width: 2px; }
+.tl-z .ln-area { opacity: 0.16; }
+.tl-z .ln-mean { opacity: 0.6; stroke-width: 1px; }
+.tl-z .ln-bar { stroke-width: 2px; }
+/* --surface-2 vanishes on the light theme's white card; a hint of --text shows in both */
+.hyp-band { fill: color-mix(in oklab, var(--text) 6%, var(--surface)); }
+.hyp-run { opacity: 0.95; }
+/* fill set in CSS: runs drawn with a fill="var(--…)" attribute showed no colour on Firefox Android */
+.hyp-deep { fill: var(--deep); } .hyp-light { fill: var(--light); }
+.hyp-rem { fill: var(--rem); } .hyp-wake { fill: var(--wake); }
+.hyp-riser { stroke: var(--muted); stroke-width: 1px; opacity: 0.55; }
+.rpt-legend .sw { width: 12px; height: 12px; }
+@media (max-width: 560px) {
+  .tl-z { padding: 4px 0 4px; }
+  .tl-inner { padding: 0 10px; }
+  .tl-z .tl-row { height: 88px; }
+}
